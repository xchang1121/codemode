{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xchang1121/codemode/raw/main/codemode.config.schema.json",
  "title": "Code Mode Gateway Configuration",
  "description": "Configuration for a reusable MCP Code Mode gateway and its upstream MCP servers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["servers"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "default": 1 },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
      },
      "additionalProperties": { "$ref": "#/$defs/server" }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposeDirectTools": { "type": "boolean", "default": true },
        "hintDelivery": {
          "enum": ["content", "meta", "both", "off"],
          "default": "both"
        },
        "maxActiveHints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 2
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "$ref": "#/$defs/positiveInteger" },
        "perToolTimeoutMs": { "$ref": "#/$defs/positiveInteger" },
        "memoryLimitBytes": { "$ref": "#/$defs/positiveInteger" },
        "maxStackBytes": { "$ref": "#/$defs/positiveInteger" },
        "maxCodeBytes": { "$ref": "#/$defs/positiveInteger" },
        "maxToolCalls": { "$ref": "#/$defs/positiveInteger" },
        "maxConcurrentToolCalls": { "$ref": "#/$defs/positiveInteger" },
        "maxResultBytes": { "$ref": "#/$defs/positiveInteger" },
        "maxLogEntries": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOrder": { "$ref": "#/$defs/positiveInteger" },
        "minimumOccurrences": { "$ref": "#/$defs/positiveInteger" },
        "minimumBindingReplayProbability": { "$ref": "#/$defs/probability" },
        "minimumConstantSupport": { "$ref": "#/$defs/positiveInteger" },
        "decayHalfLifeEvents": { "$ref": "#/$defs/positiveInteger" },
        "maxPatterns": { "$ref": "#/$defs/positiveInteger" },
        "maxSamplesPerPool": { "$ref": "#/$defs/positiveInteger" },
        "maxSessionEvents": { "$ref": "#/$defs/positiveInteger" },
        "maxSuggestions": { "$ref": "#/$defs/positiveInteger" },
        "beamWidthPerTool": { "$ref": "#/$defs/positiveInteger" },
        "maxPathDepth": { "$ref": "#/$defs/positiveInteger" },
        "maxEvidenceCandidatesPerPath": { "$ref": "#/$defs/positiveInteger" },
        "maxPersistedEvidenceBytes": { "$ref": "#/$defs/positiveInteger" },
        "persistBindingEvidence": { "type": "boolean", "default": true },
        "learnCausalSubsequences": { "type": "boolean", "default": true },
        "indexToolSuffixes": { "type": "boolean", "default": true }
      }
    },
    "state": {
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "debounceMs": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxStateBytes": { "$ref": "#/$defs/positiveInteger" }
          }
        }
      ],
      "default": {
        "path": ".codemode/state.json",
        "debounceMs": 500
      }
    }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "stdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "command"],
      "properties": {
        "transport": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "env": { "$ref": "#/$defs/stringMap" },
        "maxBufferSize": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "httpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "url"],
      "properties": {
        "transport": { "const": "http" },
        "url": { "type": "string", "minLength": 1 },
        "headers": { "$ref": "#/$defs/stringMap" }
      }
    },
    "server": {
      "oneOf": [
        { "$ref": "#/$defs/stdioServer" },
        { "$ref": "#/$defs/httpServer" }
      ]
    }
  }
}
