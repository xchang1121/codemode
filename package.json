{
  "name": "@xchang1121/codemode",
  "version": "0.1.0",
  "description": "MCP Code Mode gateway with learned PPM + trie tool-path hints",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20.17"
  },
  "files": [
    "dist",
    "examples",
    "codemode.config.schema.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codemode": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/cli.js",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test": "vitest run",
    "test:e2e": "node ./scripts/smoke-cli.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "typescript": "6.0.2",
    "vitest": "3.2.7"
  }
}
