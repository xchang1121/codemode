{
  "name": "@xchang1121/codemode",
  "version": "0.1.0",
  "description": "MCP Code Mode gateway with learned PPM + trie tool-path hints",
  "type": "module",
  "license": "MIT",
  "author": "xchang1121",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xchang1121/codemode.git"
  },
  "homepage": "https://github.com/xchang1121/codemode#readme",
  "bugs": {
    "url": "https://github.com/xchang1121/codemode/issues"
  },
  "keywords": [
    "mcp",
    "code-mode",
    "agent",
    "tool-use",
    "tool-orchestration"
  ],
  "sideEffects": false,
  "private": false,
  "engines": {
    "node": ">=20.17"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "scripts/learning-ablation.mjs",
    "codemode.config.schema.json",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codemode": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench:learning": "npm run build && node ./scripts/learning-ablation.mjs",
    "prepack": "npm run build",
    "start": "node ./dist/cli.js",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test": "vitest run",
    "test:e2e": "node ./scripts/smoke-cli.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "typescript": "6.0.2",
    "vitest": "3.2.7"
  }
}
